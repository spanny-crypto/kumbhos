# ============================================================================
# KumbhOS environment configuration
#
# The app runs fully in DEMO MODE with zero variables set below beyond
# DEMO_MODE itself. Every other variable is OPTIONAL and only takes effect
# once you provision the real service — leaving it unset never crashes the
# app, it just keeps that subsystem in demo/fallback mode. See docs/DEMO.md
# and docs/TROUBLESHOOTING.md.
# ============================================================================

# --- Mode -------------------------------------------------------------------
# "true"  -> always use synthetic in-memory data, ignore Supabase entirely.
# "false" -> use Supabase if SUPABASE_URL + keys are present and reachable,
#            otherwise automatically fall back to demo data (logged, never
#            a silent failure).
DEMO_MODE=true

# --- App ----------------------------------------------------------------
# Public origin of the deployment. Used for absolute links, never for
# secret data. Must NOT be localhost in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (optional — only used when DEMO_MODE=false) -------------------
# Project URL, safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
# Anon/public key, safe to expose to the browser (RLS enforces access).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server URL used by API routes (usually same as NEXT_PUBLIC_SUPABASE_URL).
SUPABASE_URL=
# Service-role key. SERVER-SIDE ONLY. Never prefix with NEXT_PUBLIC_.
# Never import the module that reads this into a Client Component.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string, only needed for migrations/tooling.
DATABASE_URL=

# --- AI (optional) -----------------------------------------------------
# OpenAI-compatible chat completions endpoint. Works with a self-hosted
# Ollama/vLLM server or a compatible hosted provider. SERVER-SIDE ONLY.
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=

# --- Maps / Weather (optional) -----------------------------------------
# The prototype map uses MapLibre + OpenStreetMap tiles, which need no key.
# Set this only if you swap in a paid tile provider (e.g. Mapbox/Mappls).
MAP_API_KEY=
# Open-Meteo requires no key; left here for parity if you swap providers.
WEATHER_API_KEY=

# --- Auth (demo mode) ----------------------------------------------------
# Signs the demo command-centre session cookie. Generate a random 32+ char
# string for any real deployment — never reuse the placeholder below.
AUTH_SESSION_SECRET=change-me-to-a-random-32-plus-character-string
